[Unit]
Description=Set the display backlight from ambient light at boot
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target shutdown.target preluded.service
Conflicts=shutdown.target
ConditionPathIsDirectory=/sys/class/backlight

[Service]
Type=oneshot
ExecStart=/usr/bin/preludectl initial-backlight
TimeoutStartSec=10s

[Install]
WantedBy=sysinit.target
