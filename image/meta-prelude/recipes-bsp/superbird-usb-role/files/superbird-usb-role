#!/bin/sh
set -eu

STATE_DIR=/var/lib/superbird-usb-role
BOOT_ROLE_FILE="$STATE_DIR/boot-role"
REVERT_UNIT=superbird-usb-role-revert
DEFAULT_REVERT_SECS=300
SYSTEMCTL=${PRELUDE_SYSTEMCTL:-systemctl}
SYSTEMD_RUN=${PRELUDE_SYSTEMD_RUN:-systemd-run}

role_switch() {
    if [ -n "${PRELUDE_ROLE_SWITCH_PATH:-}" ]; then
        [ -f "$PRELUDE_ROLE_SWITCH_PATH" ] || {
            echo "configured USB role switch is not a file" >&2
            return 1
        }
        printf '%s' "$PRELUDE_ROLE_SWITCH_PATH"
        return 0
    fi
    for sw in /sys/class/usb_role/*/; do
        [ -e "$sw/role" ] && { printf '%s' "$sw/role"; return 0; }
    done
    echo "no usb role switch found; kernel or dt does not expose one" >&2
    return 1
}

set_role() {
    printf '%s' "$1" > "$(role_switch)"
}

revert_active() {
    "$SYSTEMCTL" is-active --quiet "$REVERT_UNIT.timer" "$REVERT_UNIT.service" 2>/dev/null
}

cancel_revert_timer() {
    "$SYSTEMCTL" stop "$REVERT_UNIT.timer" 2>/dev/null || true
}

cancel_revert_all() {
    "$SYSTEMCTL" stop "$REVERT_UNIT.timer" 2>/dev/null || true
    "$SYSTEMCTL" stop "$REVERT_UNIT.service" 2>/dev/null || true
    if revert_active; then
        echo "failed to stop the scheduled USB-role revert" >&2
        return 1
    fi
}

schedule_revert() {
    "$SYSTEMD_RUN" --collect --unit "$REVERT_UNIT" --on-active="${1}s" \
        /bin/sh -c 'if [ -x /usr/bin/preludectl ]; then /usr/bin/preludectl device-mode || { rc=$?; systemctl start --no-block prelude-device-recovery.service 2>/dev/null || true; exit "$rc"; }; else PRELUDE_ROLE_CONTROLLER=1 exec /usr/bin/superbird-usb-role to-device; fi' \
        >/dev/null
}

require_controller() {
    if [ "${PRELUDE_ROLE_CONTROLLER:-}" != 1 ]; then
        echo "role mutations are private; use preludectl" >&2
        exit 1
    fi
}

usage() {
    cat <<EOF
usage: superbird-usb-role <command>
  to-host [--revert-secs N | --no-revert]  switch the port to host role;
                                           reverts to device after N seconds
                                           (default $DEFAULT_REVERT_SECS) unless confirmed
  to-device                                switch back to device (gadget) role
  confirm                                  cancel a scheduled revert
  persist <host|device|clear>              set/clear the role applied at boot
  status                                   current role, pending revert, boot role
EOF
}

cmd="${1:-status}"
case "$cmd" in
    to-host)
        require_controller
        shift
        revert_secs="$DEFAULT_REVERT_SECS"
        while [ $# -gt 0 ]; do
            case "$1" in
                --revert-secs) revert_secs="$2"; shift 2 ;;
                --no-revert) revert_secs=0; shift ;;
                *) usage >&2; exit 2 ;;
            esac
        done
        cancel_revert_all
        if [ "$revert_secs" -gt 0 ]; then
            schedule_revert "$revert_secs"
            if ! set_role host; then
                cancel_revert_all || true
                exit 1
            fi
            echo "host role set; reverting to device in ${revert_secs}s unless confirmed"
        else
            set_role host
            echo "host role set; no automatic revert"
        fi
        ;;
    to-device)
        require_controller
        # This command may be a child of the transient revert service.
        cancel_revert_timer
        set_role device
        echo "device role set"
        ;;
    confirm)
        require_controller
        if ! revert_active; then
            echo "no active USB-role trial to confirm" >&2
            exit 1
        fi
        cancel_revert_all
        echo "scheduled revert cancelled"
        ;;
    persist)
        require_controller
        mkdir -p "$STATE_DIR"
        case "${2:-}" in
            host|device) printf '%s\n' "$2" > "$BOOT_ROLE_FILE"; echo "boot role: $2" ;;
            clear) rm -f "$BOOT_ROLE_FILE"; echo "boot role cleared" ;;
            *) usage >&2; exit 2 ;;
        esac
        ;;
    status)
        echo "role: $(cat "$(role_switch)")"
        if revert_active; then
            echo "revert: scheduled ($("$SYSTEMCTL" show "$REVERT_UNIT.timer" -P NextElapseUSecMonotonic 2>/dev/null))"
        else
            echo "revert: none"
        fi
        echo "boot role: $(cat "$BOOT_ROLE_FILE" 2>/dev/null || echo device)"
        ;;
    *)
        usage >&2
        [ "$cmd" = "-h" ] || [ "$cmd" = "--help" ] && exit 0
        exit 2
        ;;
esac
